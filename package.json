{
  "name": "watch-party",
  "version": "1.0.0",
  "description": "Zero-buffering local video watch party application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "share": "npx localtunnel --port 3000",
    "test": "jest --testPathPatterns=tests/ --forceExit",
    "test:watch": "jest --testPathPatterns=tests/ --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000,
    "verbose": true
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ws": "^8.22.0"
  }
}
